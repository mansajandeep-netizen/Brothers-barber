# Copy to .env and fill in. Real environment variables override this file.

# --- Server ---
NODE_ENV=production
PORT=3000
# Public address of the site (used for canonical URLs, emails, sitemap). No trailing slash.
SITE_URL=https://www.example.com
# Set to true when running behind a reverse proxy (Caddy, Nginx, Render, Fly…) so client IPs are correct.
TRUST_PROXY=true
# Where the SQLite database lives. Put it on persistent storage.
DATABASE_PATH=./data/manhandler.db

# --- First owner account (only used when no accounts exist yet; remove afterwards) ---
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_NAME=Owner

# --- Email (booking confirmations) ---
# From address customers see, e.g. "Manhandler Barbershop <bookings@yourdomain.ca>"
MAIL_FROM=
# Optional: where replies go
MAIL_REPLY_TO=
# Optional: extra inbox for new-booking / cancellation alerts (the Business Info email is also used)
SHOP_NOTIFY_EMAIL=

# Option A — Resend (https://resend.com)
RESEND_API_KEY=

# Option B — any SMTP server (Google Workspace / Gmail app password, Zoho, Outlook, Amazon SES…)
SMTP_HOST=
SMTP_PORT=465
# true for port 465 (implicit TLS); false for 587 (STARTTLS is used automatically)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# --- Tuning (optional) ---
# SESSION_DAYS=7
# BOOKING_RATE_LIMIT=20
# SHOP_TIMEZONE=America/Edmonton
